# Copy to .env (uncommitted), or run scripts/init_env.sh to generate the secrets below.
# Copernicus S3 keys: https://eodata-s3keysmanager.dataspace.copernicus.eu/ (the account login is not needed)
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
POSTGRES_PASSWORD=
STORE_ACCESS_KEY=sar
STORE_SECRET_KEY=
GRAFANA_DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
# Used when running the API outside compose (compose sets these itself)
STORE_ENDPOINT_URL=http://objectstore:8333
PIPELINE_LAND_POLYGONS=data/land/great-belt.geojson
