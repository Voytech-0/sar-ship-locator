# Copy to .env (uncommitted) and fill in. Used by docker compose and the pipeline.
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-too
MINIO_ENDPOINT_URL=http://minio:9000
# Land polygons from `make land` (OSM, ODbL); the production API refuses to start without it
PIPELINE_LAND_POLYGONS=data/land/great-belt.geojson
