{
  "uid": "sar-detections",
  "title": "Detections",
  "tags": [
    "sar-ship-locator"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "api_url",
        "query": "http://localhost:8000",
        "hide": 2
      },
      {
        "type": "custom",
        "name": "label",
        "label": "Label",
        "query": "All,matched,unmatched,ambiguous,unvalidated",
        "options": [
          {
            "text": "All",
            "value": "All",
            "selected": true
          },
          {
            "text": "matched",
            "value": "matched",
            "selected": false
          },
          {
            "text": "unmatched",
            "value": "unmatched",
            "selected": false
          },
          {
            "text": "ambiguous",
            "value": "ambiguous",
            "selected": false
          },
          {
            "text": "unvalidated",
            "value": "unvalidated",
            "selected": false
          }
        ],
        "current": {
          "text": "All",
          "value": "All",
          "selected": true
        }
      },
      {
        "type": "custom",
        "name": "shore",
        "label": "Shore",
        "query": "All,open_water,near_shore",
        "options": [
          {
            "text": "All",
            "value": "All",
            "selected": true
          },
          {
            "text": "open_water",
            "value": "open_water",
            "selected": false
          },
          {
            "text": "near_shore",
            "value": "near_shore",
            "selected": false
          }
        ],
        "current": {
          "text": "All",
          "value": "All",
          "selected": true
        }
      },
      {
        "type": "query",
        "name": "detector",
        "label": "Detector version",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "postgis"
        },
        "query": "SELECT v FROM (SELECT 'All' AS v UNION SELECT DISTINCT detector_version FROM detections) t ORDER BY (v = 'All'), v DESC",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Detections per Scene",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT s.acquired_at AS time, count(d.id) AS detections\nFROM scenes s\nLEFT JOIN detections d ON d.scene_id = s.scene_id\n  AND ('$detector' = 'All' OR d.detector_version = '$detector')\nWHERE $__timeFilter(s.acquired_at)\nGROUP BY s.scene_id, s.acquired_at\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "title": "Matched / unmatched / ambiguous per Scene",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT s.acquired_at AS time, v.label::text AS metric, count(*) AS value\nFROM validations v\nJOIN detections d ON d.id = v.detection_id\nJOIN scenes s ON s.scene_id = d.scene_id\nWHERE $__timeFilter(s.acquired_at)\n  AND ('$detector' = 'All' OR d.detector_version = '$detector')\nGROUP BY s.acquired_at, v.label\nORDER BY 1"
        }
      ]
    },
    {
      "id": 3,
      "title": "Validation split",
      "type": "piechart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT v.label::text AS label, count(*) AS detections\nFROM validations v\nJOIN detections d ON d.id = v.detection_id\nJOIN scenes s ON s.scene_id = d.scene_id\nWHERE $__timeFilter(s.acquired_at)\n  AND ('$detector' = 'All' OR d.detector_version = '$detector')\nGROUP BY v.label"
        }
      ]
    },
    {
      "id": 4,
      "title": "Recent Detections",
      "type": "geomap",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 16,
        "h": 14
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "gray",
                "value": 3
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "unmatched",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "matched",
                  "color": "green",
                  "index": 1
                },
                "2": {
                  "text": "ambiguous",
                  "color": "yellow",
                  "index": 2
                },
                "3": {
                  "text": "unvalidated",
                  "color": "gray",
                  "index": 3
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ST_Y(d.geom) AS latitude, ST_X(d.geom) AS longitude,\n       COALESCE(v.label::text, 'unvalidated') AS label,\n       CASE v.label WHEN 'unmatched' THEN 0 WHEN 'matched' THEN 1 WHEN 'ambiguous' THEN 2 ELSE 3 END AS class,\n       d.confidence, d.length_m, d.shore::text AS shore, s.acquired_at\nFROM detections d\nJOIN scenes s ON s.scene_id = d.scene_id\nLEFT JOIN validations v ON v.detection_id = d.id\nWHERE $__timeFilter(s.acquired_at)\n  AND ('$detector' = 'All' OR d.detector_version = '$detector')\nORDER BY s.acquired_at DESC\nLIMIT 5000"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 55.35,
          "lon": 11.0,
          "zoom": 8
        },
        "basemap": {
          "type": "osm-standard"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Detections",
            "config": {
              "style": {
                "size": {
                  "fixed": 5
                },
                "color": {
                  "field": "class",
                  "fixed": "blue"
                },
                "opacity": 0.8
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "tooltip": true
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "Dark-ship candidates (unmatched, open water, 100 m or longer, confidence 0.9 or more)",
      "type": "geomap",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.lat AS latitude, c.lon AS longitude, c.confidence, c.length_m, c.scene_id, c.acquired_at\nFROM dark_ship_candidates c\nWHERE $__timeFilter(c.acquired_at)\nORDER BY c.acquired_at DESC\nLIMIT 500"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 55.35,
          "lon": 11.0,
          "zoom": 8
        },
        "basemap": {
          "type": "osm-standard"
        },
        "layers": [
          {
            "type": "markers",
            "name": "Dark-ship candidates",
            "config": {
              "style": {
                "size": {
                  "fixed": 9
                },
                "color": {
                  "fixed": "red"
                },
                "opacity": 0.9
              }
            },
            "location": {
              "mode": "coords",
              "latitude": "latitude",
              "longitude": "longitude"
            },
            "tooltip": true
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Dark-ship candidates: chips and detail",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 12
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "chip"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "image",
                  "title": "chip"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT '$api_url/v1/detections/' || c.detection_id || '/chip' AS chip,\n       c.acquired_at, c.confidence, c.length_m, c.lat AS latitude, c.lon AS longitude, c.scene_id\nFROM dark_ship_candidates c\nWHERE $__timeFilter(c.acquired_at)\n  AND ('$detector' = 'All' OR c.detector_version = '$detector')\nORDER BY c.acquired_at DESC, c.confidence DESC\nLIMIT 100"
        }
      ],
      "options": {
        "cellHeight": "lg",
        "showHeader": true
      }
    },
    {
      "id": 7,
      "title": "Chip gallery (highest confidence first; filter by label and shore above)",
      "type": "table",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgis"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 16
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "chip"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "image",
                  "title": "chip"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgis"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT '$api_url/v1/detections/' || d.id || '/chip' AS chip,\n       COALESCE(v.label::text, 'unvalidated') AS label,\n       d.confidence, d.length_m, d.shore::text AS shore, s.acquired_at\nFROM detections d\nJOIN scenes s ON s.scene_id = d.scene_id\nLEFT JOIN validations v ON v.detection_id = d.id\nWHERE d.chip_key IS NOT NULL AND $__timeFilter(s.acquired_at)\n  AND ('$label' = 'All' OR COALESCE(v.label::text, 'unvalidated') = '$label')\n  AND ('$shore' = 'All' OR d.shore::text = '$shore')\n  AND ('$detector' = 'All' OR d.detector_version = '$detector')\nORDER BY d.confidence DESC\nLIMIT 60"
        }
      ],
      "options": {
        "cellHeight": "lg",
        "showHeader": true
      }
    }
  ]
}
